[Desktop Entry]
Name=Selucid
Comment=SELinux AVC denial visualizer and troubleshooter
GenericName=SELinux Troubleshooter
Exec=/usr/bin/selucid-gui %f
Icon=selucid
Terminal=false
Type=Application
Categories=System;Monitor;Security;
Keywords=SELinux;AVC;denial;audit;security;policy;Fedora;RHEL;
StartupNotify=true
MimeType=application/octet-stream;
Actions=new-window;

[Desktop Action new-window]
Name=Open a new window
Exec=/usr/bin/selucid-gui
